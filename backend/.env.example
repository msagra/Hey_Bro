# Hey Bro - Backend API Keys (template)
# Copy this file to `.env` and fill in your real keys before running.
#
#   GROQ_API_KEY     - Groq Whisper STT (whisper-large-v3, primary), the Groq
#                      LLM fallback (llama-3.3-70b-versatile) and PlayAI TTS.
#   DEEPSEEK_API_KEY - primary decision engine (deepseek-chat, OpenAI-compatible).
#   GEMINI_API_KEY   - secondary decision-engine fallback (gemini-2.0-flash).
#
# Optional overrides (safe defaults are used when unset):
#   DEEPSEEK_BASE_URL=https://api.deepseek.com
#   DEEPSEEK_MODEL=deepseek-chat
#   GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here
# Groq PlayAI male/deep voice. Fritz-PlayAI is the default.
GROQ_TTS_VOICE=Fritz-PlayAI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
